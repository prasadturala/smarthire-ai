# ==============================================================================
# SmartHire AI - Global Environment Configuration
# ==============================================================================

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=smarthire_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001

# AI API Keys (Configure at least one)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_optional

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER=smarthire_user
POSTGRES_PASSWORD=smarthire_secure_password
POSTGRES_DB=smarthire_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://smarthire_user:smarthire_secure_password@localhost:5432/smarthire_db

# Redis Cache & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AI_SERVICE_URL=http://localhost:8001/ai/v1
PORT=3000
